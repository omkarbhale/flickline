{
  "name": "flickline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "First-person aim and movement trainer with tactical-shooter gunplay, instant feedback, and skill-matched difficulty",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audio:snapshot": "AUDIO_SNAPSHOT_DIR=docs/audio vitest run src/audio/snapshot.test.ts",
    "map-lint": "node scripts/map-lint.mjs",
    "bot": "node scripts/bot.mjs",
    "baseline:items": "node scripts/gen-baseline-items.mjs",
    "perf": "node scripts/perf.mjs",
    "reward-experiment": "vitest run src/feedback/contactExperiment.test.ts"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
